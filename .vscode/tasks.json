{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SIGE-360: 1. Servidor MCP (Python :8000)",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Python\\Python312\\python.exe",
      "args": ["-u", "agente/servidor_mcp.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SIGE-360: 2. n8n Local (:5678)",
      "type": "process",
      "command": "npx.cmd",
      "args": ["--yes", "n8n"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SIGE-360: 3. App Web FastAPI (:3060)",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\Python\\Python312\\python.exe",
      "args": ["-u", "-m", "uvicorn", "app:app", "--port", "3060"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SIGE-360: Iniciar todos los servicios",
      "dependsOn": [
        "SIGE-360: 1. Servidor MCP (Python :8000)",
        "SIGE-360: 2. n8n Local (:5678)",
        "SIGE-360: 3. App Web FastAPI (:3060)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
