# Configuración de la aplicación web SIGE-360 (copiar como .env, NO subir a GitHub)
PORT=3060
MCP_PORT=8000
SESSION_SECRET=cambia_este_secreto_local_sige360

# Base de datos PostgreSQL (para la app web / simulador RFID)
PGHOST=localhost
PGPORT=5432
PGDATABASE=sige360
PGUSER=postgres
PGPASSWORD=tu_password_postgres

# Usuario PostgreSQL con privilegios mínimos para el servidor MCP
MCP_PGUSER=agente_sige
MCP_PGPASSWORD=clave_sige360_segura

# URL de producción del Webhook de n8n (Ruta A)
# Ejemplo local: http://localhost:5678/webhook/agente
N8N_WEBHOOK_URL=http://localhost:5678/webhook/agente

# Telegram Bot API (100% gratis vía @BotFather - opcional para alertas en vivo al celular)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seguridad avanzada (producción)
COOKIE_SECURE=false
IOT_DISPLAY_KEY=sige360_iot_sala_profesores_2026
